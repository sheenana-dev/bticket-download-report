# Apple App Store Connect
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=       # Full .p8 file contents (multi-line)
APPLE_VENDOR_NUMBER=
APPLE_APP_SKU=

# Google Play Console (GCS CSV export)
GOOGLE_APPLICATION_CREDENTIALS=  # Path to service account JSON file
GOOGLE_PACKAGE_NAME=             # e.g., com.bticket.app
GOOGLE_BUCKET_ID=                # GCS bucket ID (numbers only)

# Huawei AppGallery Connect
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=
HUAWEI_APP_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Revenue report (all optional; defaults shown) ---------------------------
# REVENUE_TELEGRAM_CHAT_ID=      # send revenue to a different group (default: TELEGRAM_CHAT_ID)
# REVENUE_CURRENCY=PHP
# REVENUE_GOOGLE_FEE_RATE=0.15   # daily estimate only; monthly uses real fee lines
# REVENUE_HUAWEI_FEE_RATE=0.15
# REVENUE_FX_OVERRIDES=          # e.g. USD:56.20,CNY:7.80 — pins rates, skips FX API
# Huawei IAP export — pin after running: python -m src.revenue.main probe huawei
# HUAWEI_IAP_REPORT_PATH=/api/report/distribution-operation-quality/v1/IAPReportExport/{app_id}
# HUAWEI_IAP_AMOUNT_COLUMN=Paid amount
# HUAWEI_IAP_COUNT_COLUMN=Paid orders
# HUAWEI_IAP_CURRENCY=CNY
